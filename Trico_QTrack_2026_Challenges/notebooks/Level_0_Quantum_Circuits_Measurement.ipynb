    "def phase_flip_detector() -> QuantumCircuit:\n",
    "    \"\"\"Create a circuit applying H, then Z, then H to |0⟩ (no measurements).\"\"\"\n",
    "    flip = QuantumCircuit(1)\n",
    "    flip.h(0)\n",
    "    flip.z(0)\n",
    "    flip.h(0)\n",
    "    return flip"
   ]
