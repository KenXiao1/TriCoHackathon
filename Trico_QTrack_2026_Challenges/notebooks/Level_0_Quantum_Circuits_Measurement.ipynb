    "# First run: installs dependencies only if missing (requires internet).\n",
    "import sys, subprocess, importlib.util\n",
    "if importlib.util.find_spec(\"qiskit\") is None or importlib.util.find_spec(\"qiskit_aer\") is None or importlib.util.find_spec(\"qiskit_ibm_runtime\") is None:\n",
    "    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"qiskit>=2.5,<3\", \"qiskit-aer>=0.17,<0.19\", \"qiskit-ibm-runtime\", \"numpy>=1.26,<3\", \"matplotlib>=3.8\"])\n",
    "import numpy as np\n",
    "from qiskit import QuantumCircuit\n",
    "from qiskit.quantum_info import Statevector\n",
    "from qiskit_aer import AerSimulator\n",
    "from qiskit.transpiler.preset_passmanagers import generate_preset_pass_manager\n",
    "from qiskit_ibm_runtime import SamplerV2 as Sampler, QiskitRuntimeService\n",
    "print(\"Qiskit ready. Free local simulation only; no IBM account or paid hardware required.\")"
   ]
  },
