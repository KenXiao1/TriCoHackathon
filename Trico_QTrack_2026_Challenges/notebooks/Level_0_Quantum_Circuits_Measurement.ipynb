    "def sample_plus(shots: int = 1024, seed: int = 7) -> dict:\n",
    "    \"\"\"Measure |+⟩ with the given number of shots and random seed; return counts dict.\"\"\"\n",
    "    plus = QuantumCircuit(1)\n",
    "    plus.h(0)\n",
    "    plus.measure_all()\n",
    "\n",
    "    pm = generate_preset_pass_manager(backend=AerSimulator(), optimization_level=1)\n",
    "    isa_circuit = pm.run(plus)\n",
    "\n",
    "    sampler = Sampler(mode=AerSimulator())\n",
    "\n",
    "    job = sampler.run([isa_circuit], shots=shots)\n",
    "    result = job.result()\n",
    "\n",
    "    return result[0].data.meas.get_counts()\n"
